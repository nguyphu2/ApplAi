{
  "manifest_version": 3,
  "name": "ApplAI Resume Optimizer",
  "version": "0.1.0",
  "description": "Optimize your resume for a job description using your saved ApplAI profile.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon128.png"
  },
  "icons": {
    "16": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["identity", "storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://q3xyo18vh7.execute-api.us-east-1.amazonaws.com/*",
    "https://applai-nguyphu2.auth.us-east-1.amazoncognito.com/*"
  ]
}
